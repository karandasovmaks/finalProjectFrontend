<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.Enterfragment"
    android:background="@drawable/fragment_enter_background"
    android:id="@+id/toggleGroup">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="107dp"
            android:layout_height="107dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="Добро пожаловать!"
            android:textColor="@color/black"
            android:textSize="48px" />



        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/loginInput"
            android:layout_width="220dp"
            android:layout_height="31dp"
            android:layout_margin="20dp"
            android:background="@drawable/slider_outline"
            android:hint="Логин"
            android:paddingLeft="10dp"
            android:textColor="@color/black"
            android:textColorHint="@color/greyhint"/>

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/passwordInput"
            android:layout_width="220dp"
            android:layout_height="31dp"
            android:background="@drawable/slider_outline"
            android:hint="Пароль"
            android:paddingLeft="10dp"
            android:textColor="@color/black"
            android:textColorHint="@color/greyhint"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/loginButton"
            android:layout_margin="20dp"
            android:layout_width="220dp"
            android:layout_height="45dp"
            android:background="@drawable/button_background"
            android:text="Войти"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/noAccountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60dp"
            android:text="у меня нет аккаунта"
            android:textColor="@color/linkcolor"/>


    </LinearLayout>
</FrameLayout>