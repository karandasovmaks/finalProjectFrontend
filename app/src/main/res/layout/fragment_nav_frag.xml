<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearLayout"
    android:layout_width="match_parent"
    android:layout_height="85dp"
    android:orientation="horizontal"
    android:gravity="center"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    android:background="@color/white">
    >


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/book"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginHorizontal="50dp"
        android:background="@drawable/open_book_svgrepo_com_5"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/towpers"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginHorizontal="50dp"
        android:background="@drawable/class_management_svgrepo_com_1"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/onepers"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginHorizontal="50dp"
        android:background="@drawable/avatar_man_profile_svgrepo_com_1"/>
</LinearLayout>