<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fragment_enter_background"
    android:padding="16dp">

    <com.google.android.material.textfield.MaterialAutoCompleteTextView
        android:id="@+id/test_create_name"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/slider_outline"
        android:hint="Название теста"
        android:padding="10dp"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.MaterialAutoCompleteTextView
        android:id="@+id/test_create_desc"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/slider_outline"
        android:hint="Описание теста"
        android:padding="10dp"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/test_create_name" />

    <TextView
        android:id="@+id/test_create_tasks_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Вопросы:"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/test_create_desc" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/test_create_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="10dp"
        app:layout_constraintBottom_toTopOf="@+id/test_create_add_task"
        app:layout_constraintTop_toBottomOf="@+id/test_create_tasks_label" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/test_create_add_task"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/button_background"
        android:text="+ Добавить вопрос"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/test_create_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/test_create_save"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/button_background"
        android:text="Сохранить тест"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
